# Copia este archivo como ".env" y completa los valores reales ahí.
# El archivo ".env" nunca se sube al repositorio (ya está excluido en .gitignore).

# Llave de API de Google Gemini. Se obtiene gratis en https://aistudio.google.com (Get API key).
GEMINI_API_KEY=tu_llave_aqui

# Modelo a usar (opcional). Si se deja vacío, se usa gemini-3.6-flash.
# Si se alcanza el límite de cuota, se puede cambiar por gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.6-flash